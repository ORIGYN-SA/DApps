{
  "name": "origyn-dapps",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint ./src/**/*.tsx",
    "prepare": "husky",
    "build_explorer:staging": "vite build --config vite.config.explorer.ts --mode staging --emptyOutDir",
    "build_explorer:preprod": "vite build --config vite.config.explorer.ts --mode preprod --emptyOutDir",
    "build_explorer:production": "vite build --config vite.config.explorer.ts --mode production --emptyOutDir",
    "build_collection:staging": "vite build --config vite.config.collection.ts --mode staging --emptyOutDir",
    "build_collection:preprod": "vite build --config vite.config.collection.ts --mode preprod --emptyOutDir",
    "build_collection:production": "vite build --config vite.config.collection.ts --mode production --emptyOutDir",
    "dev:explorer": "vite --mode dev --config vite.config.explorer.ts",
    "dev:collection": "vite --mode dev --config vite.config.collection.ts"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-import-resolver-typescript": "^3.4.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.6",
    "jest-environment-jsdom": "^28.1.3",
    "jest-environment-jsdom-global": "^3.1.2",
    "lint-staged": "^15.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwindcss": "^3.4.11",
    "vite": "^5.4.11",
    "vite-plugin-environment": "1.1.3",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-singlefile": "^2.0.2",
    "vite-plugin-svgr": "^4.2.0",
    "@testing-library/react": "^14.0.0",
    "history": "^5.3.0",
    "isomorphic-fetch": "^3.0.0",
    "@eslint/js": "^8.0.0",
    "globals": "^13.12.0",
    "eslint-plugin-react-refresh": "^0.3.0"
  },
  "dependencies": {
    "@dfinity/agent": "^2.1.2",
    "@dfinity/candid": "^2.1.2",
    "@dfinity/principal": "^2.1.2",
    "@nfid/identitykit": "^0.0.4",
    "@tanstack/react-query": "^5.56.2",
    "@vitejs/plugin-react": "^4.3.1",
    "jotai": "^2.0.0"
  },
  "browserslist": [
    "last 2 chrome version",
    "last 2 firefox version",
    "last 2 safari version",
    "last 2 edge version"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "node_modules/.bin/eslint --max-warnings=0"
    ]
  }
}
