{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "jsx": "react-jsx",
    "noImplicitAny": false,
    "outDir": "dist",
    "preserveConstEnums": true,
    "removeComments": true,
    "sourceMap": true,
    "target": "ESNext",
    "moduleResolution": "Node",
    "allowJs": true,
    "rootDir": ".",
    "lib": ["es5", "es6", "esnext", "dom", "dom.iterable"],
    "jsxImportSource": "react",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@dapp/app-ledger": ["./src/pages/ledger.astro"],
      "@dapp/app-vault": ["./src/pages/vault.astro"],
      "@dapp/app-nft-data": ["./src/pages/nft-data.astro"],
      "@dapp/app-marketplace": ["./src/pages/marketplace.astro"],
      "@dapp/app-library": ["./src/pages/library.astro"],
      "@dapp/common-assets": ["./src/packages/common/assets/src/index.ts"],
      "@dapp/common-constants": ["./src/packages/common/constants/src/index.ts"],
      "@dapp/common-hooks": ["./src/packages/common/hooks/src/index.ts"],
      "@dapp/common-types": ["./src/packages/common/types/src/index.ts"],
      "@dapp/features-authentication": ["./src/packages/features/authentication/src/index.ts"],
      "@dapp/features-tokensdata": ["./src/packages/features/tokensdata/src/index.ts"],
      "@dapp/features-userprofile": ["./src/packages/features/userprofile/src/index.ts"],
      "@dapp/features-components": ["./src/packages/features/components/src/index.ts"],
      "@dapp/features-components/*": ["./src/packages/features/components/src/*"],
      "@dapp/utils": ["./src/packages/utils/src/index.ts"]
    }
  },
  "exclude": ["./node_modules", ".git", "./packages/**/node_modules", "./dist/**/*.js"],
  "extends": "astro/tsconfigs/strict"
}
